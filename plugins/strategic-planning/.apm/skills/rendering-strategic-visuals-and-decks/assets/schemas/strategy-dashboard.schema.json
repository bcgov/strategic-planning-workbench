{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BC Gov Strategy & Architecture Dashboard",
  "description": "Structured input for Strategy on a Page HTML dashboards and Mermaid traceability/roadmap packages.",
  "type": "object",
  "required": ["title", "org_trail", "objectives", "work_items"],
  "properties": {
    "title": { "type": "string" },
    "org_trail": { "type": "string" },
    "date": { "type": "string" },
    "vision": { "type": "string" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "tone": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger"] }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tier_link": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "current_maturity", "target_maturity"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "current_maturity": { "type": "number", "minimum": 0, "maximum": 5 },
          "target_maturity": { "type": "number", "minimum": 0, "maximum": 5 },
          "objective_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["WORK", "IDEA"] },
          "horizon": { "type": "string" },
          "start_date": { "type": "string", "description": "YYYY-MM-DD for Gantt" },
          "duration": { "type": "string", "description": "e.g., 60d or 8w for Gantt" },
          "sponsor": { "type": "string" },
          "owner": { "type": "string" },
          "capacity_confirmed": { "type": "boolean" },
          "capability_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "alt"],
        "properties": {
          "title": { "type": "string" },
          "src": { "type": "string" },
          "alt": { "type": "string", "minLength": 1 },
          "caption": { "type": "string" },
          "width": { "type": "string" },
          "embed": { "type": "boolean" }
        }
      }
    },
    "indigenous_acknowledgment": { "type": "boolean", "default": true }
  }
}
