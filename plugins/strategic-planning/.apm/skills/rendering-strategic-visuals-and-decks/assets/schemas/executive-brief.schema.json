{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BC Gov Executive Brief",
  "description": "Structured input for rendering a BC Government Design System executive one-pager or architecture brief.",
  "type": "object",
  "required": ["title", "org_trail", "summary", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "org_trail": { "type": "string", "description": "e.g., Government of British Columbia • Ministry • Branch" },
    "audience": { "type": "string", "description": "Target audience, e.g., Executive leadership, Privacy & policy reviewers" },
    "date": { "type": "string" },
    "status": { "type": "string", "description": "e.g., Draft for review, Approved direction" },
    "summary": { "type": "string", "minLength": 1 },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "tone": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger"] }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "description"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "tag": { "type": "string" },
                "tone": { "type": "string", "enum": ["neutral", "info", "success", "warning", "danger"] },
                "committed": { "type": "boolean" },
                "missing_evidence": { "type": "string" }
              }
            }
          },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "images": {
            "type": "array",
            "items": { "$ref": "#/$defs/image" }
          }
        }
      }
    },
    "hero_image": { "$ref": "#/$defs/image" },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "owner"],
        "properties": {
          "decision": { "type": "string" },
          "owner": { "type": "string" },
          "target_date": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    },
    "indigenous_acknowledgment": { "type": "boolean", "default": true }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "description": "Path to .svg, .png, .jpg, or .webp diagram/image (relative to JSON file or output)" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "width": { "type": "string", "description": "Optional CSS width, e.g., 100% or 720px" },
        "embed": { "type": "boolean", "description": "Inline/base64-encode this image into the HTML" }
      }
    }
  }
}
