{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BC Gov Domain-Grouped Diagram Gallery",
  "description": "Manifest for rendering a domain-grouped architecture diagrams gallery and individual full-view subpages from .mmd or .svg/.png sources.",
  "type": "object",
  "required": ["title", "org_trail", "summary", "domains"],
  "properties": {
    "title": { "type": "string" },
    "org_trail": { "type": "string" },
    "subtitle": { "type": "string" },
    "summary": { "type": "string" },
    "gallery_filename": { "type": "string", "default": "architecture-diagrams.html" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "items"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slug", "title", "src", "intro"],
              "properties": {
                "slug": { "type": "string" },
                "title": { "type": "string" },
                "src": { "type": "string", "description": "Path to .mmd or .svg/.png relative to JSON" },
                "intro": { "type": "string" },
                "points": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "indigenous_acknowledgment": { "type": "boolean", "default": true }
  }
}
